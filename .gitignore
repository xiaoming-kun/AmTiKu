# ══ 依赖与构建产物（可重建，不入库）══
web/node_modules/
web/dist/
node_modules/
dist/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store

# ══ 程序自身的备份与缓存 ══
# 这些是**应用运行时生成的**，会不断增长；真正的历史由 git 负责。
题目/备份/
备份/
回收站/
图片/_transparent/
待录入图片/
_handout_build/

# ══ Slidev 渲染工程（AmTiKu/slidev/）══
# 依赖与产物可再生成；**package.json / package-lock.json / styles/index.css 要入库**
slidev/node_modules/
slidev/public/img/
slidev/_handout_build/
slidev/dist/
slidev/_canvas_*

# ══ LaTeX 编译中间产物 ══
# 组卷编译会在 试卷/ 下留 .aux/.log/.out；这些是**可重新生成**的，
# 不该进版本库（初版 .gitignore 漏了，误跟踪了 3 个文件，已删除）。
*.aux
*.out
*.toc
*.synctex.gz
试卷/*.log

# ══ 生成的 PDF ══
# 试卷/讲义 PDF 可随时重新生成；要留档就 git add -f 指定文件。
试卷/*.pdf

# ══ 编辑器/工具临时文件 ══
*.bak
*.bak_*
*.tmp

# 录题修复的派生缓存（每次从库里重算，不入库）
数据/录题/_修复/pending.json

# ══ 录题的扫描页图与中间产物（**能从原 PDF 重新渲染**，不进 git）══
# 实测：这些 PNG 单张能到 30MB，把 .git 撑到 5.4G；工作区 数据/录题 6.4G 里基本都是它们。
# 保留的是 pipeline 的结构化产物（pages.json / struct_*.json / 成品.json），那些重跑要花模型时间。
数据/录题/*/pages/
数据/录题/*/small/
数据/录题/*/crops/
数据/录题/*/scan/
数据/录题/*/v2/pages/
数据/录题/*/v2/small/
数据/录题/*/v2/txt/

# ══ 题库数据（**不进 git**）════════════════════════════════════
# 项目规矩：git 只管代码、配置、文档；数据由 `amti.py snapshot` + `归档快照.json`
# + 各写库函数的自动备份负责。实测把数据放进 git 的代价：.git 涨到 5.4G。
题目/
图片/
数据/
试卷/
变更记录/
回收站/
待解/
知识点.json
归档快照.json
